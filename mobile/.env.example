# Copy this file to `.env` (git-ignored) and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API (Project URL, and the anon / publishable key).
#
# Only the anon (publishable) key belongs here. NEVER put the service_role / secret key in this
# file or anywhere in the app: the app refuses to start with one. Both values are public by design
# (they ship in the app bundle); Row Level Security is what protects the data.
#
# Restart Metro after editing: Expo inlines EXPO_PUBLIC_* values when it bundles.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Push notifications (optional; Phase 7). Neither is a secret. Leave both unset until you have
# created them: the app then runs normally and just does not register for push.
#   EAS_PROJECT_ID        - the project id printed by `eas init` (also on expo.dev -> your project).
#   GOOGLE_SERVICES_JSON  - path to Firebase's google-services.json for this build's Android
#                           package (keep the file outside git, e.g. ./google-services.json, which
#                           is git-ignored). A native rebuild (prebuild + Gradle) is needed after
#                           changing it.
# EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON=./google-services.json

# Crash reporting (optional; DEC-057). The DSN of a Sentry project for React Native (Sentry ->
# Project Settings -> Client Keys). Public by design (it only allows sending events). Unset = off.
# Restart Metro after changing it.
# EXPO_PUBLIC_SENTRY_DSN=
